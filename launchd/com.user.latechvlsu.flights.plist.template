<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.latechvlsu.flights</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>__PROJECT_DIR__/flights_amadeus.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AMADEUS_API_KEY</key>
    <string>__AMADEUS_API_KEY__</string>
    <key>AMADEUS_API_SECRET</key>
    <string>__AMADEUS_API_SECRET__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Run every 12 hours (flights don't change as fast as tickets) -->
  <key>StartInterval</key>
  <integer>43200</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/.flights.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/.flights.err.log</string>
</dict>
</plist>
